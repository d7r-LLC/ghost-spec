{
  "name": "ghost-spec",
  "version": "0.1.0",
  "private": true,
  "description": "The GHOST specification and its implementation surface: schemas, conformance register, skills, tools, and the ghost-spec.dev pipeline",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "test": "node --test tools/tests/*.test.mjs",
    "gate": "bash scripts/ci.sh",
    "extract": "node tools/extract-requirements.mjs",
    "validate": "node tools/validate.mjs --all",
    "validate:skills": "node tools/validate-skills.mjs"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "marked": "14.1.4"
  },
  "main": ".opencode/plugins/ghost-skills.js"
}
